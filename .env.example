# ==========================================
# NASA Turbofan Predictive Maintenance Config
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=turbofan_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka (KRaft) Configuration
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_TELEMETRY=turbofan_raw_telemetry
KAFKA_GROUP_ID=turbofan_consumer_group

# DagsHub / MLflow Tracking
# Signup at https://dagshub.com to get your repo tracking URI and token
DAGSHUB_USER_NAME=your_dagshub_username
DAGSHUB_REPO_NAME=nasa-turbofan-predictive-maintenance
MLFLOW_TRACKING_URI=https://dagshub.com/${DAGSHUB_USER_NAME}/${DAGSHUB_REPO_NAME}.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# FastAPI & Model Serving
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=models/best_rul_model.onnx

# Streamlit Dashboard
DASHBOARD_PORT=8501
